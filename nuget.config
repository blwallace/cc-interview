<?xml version="1.0" encoding="utf-8"?>
<!--
  Isolates this scaffold from any machine/user-level NuGet feeds (e.g. private,
  authenticated corporate feeds). Only the public nuget.org source is used.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
